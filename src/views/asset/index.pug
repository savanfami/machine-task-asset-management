extends ../layout

block content

  //- Page Header
  .p-4.mb-4.rounded-3(style='background: linear-gradient(135deg, #4f46e5, #7c3aed); color: white;')
    .d-flex.justify-content-between.align-items-center
      div
        h2.mb-1.fw-bold Asset Master
        p.mb-0.small Manage all company assets
      a.btn.btn-light.fw-semibold(href='/assets/add')
        i.bi.bi-plus-circle.me-2
        | Add Asset

  //- Asset Table
  .card.border-0.shadow-sm
    .card-body.p-4

      table.table.table-hover.align-middle#assetTable
        thead.table-dark
          tr
            th #
            th Asset Code
            th Serial Number
            th Make
            th Model
            th Branch
            th Category
            th Purchase Cost
            th Status
            th.text-center Actions

        tbody
          each asset, index in assets
            tr
              td= index + 1
              td= asset.assetCode
              td= asset.serialNumber
              td= asset.manufacturer
              td= asset.model
              td= asset.branch
              td= asset.assetCategory.name
              td ₹ #{asset.purchaseCost}

              td
                if asset.status === 'IN_STOCK'
                  span.badge.bg-success In Stock
                else if asset.status === 'ISSUED'
                  span.badge.bg-warning.text-dark Issued
                else if asset.status === 'DAMAGED'
                  span.badge.bg-danger Damaged
                else if asset.status === 'SCRAPPED'
                  span.badge.bg-secondary Scrapped

              td.text-center

                .btn-group

                  //- Edit Button
                  a.btn.btn-sm.btn-primary(
                    href=`/assets/edit/${asset.id}`
                  )
                    i.bi.bi-pencil-square.me-1
                    | Edit

                  //- Dropdown
                  button.btn.btn-sm.btn-outline-secondary.dropdown-toggle.dropdown-toggle-split(
                    type='button'
                    data-bs-toggle='dropdown'
                    aria-expanded='false'
                  )
                    span.visually-hidden Toggle Dropdown

                  ul.dropdown-menu.dropdown-menu-end

                    li
                      a.dropdown-item(
                        href=`/assets/history/${asset.id}`
                      )
                        i.bi.bi-clock-history.me-2
                        | View History

                    if asset.status !== 'SCRAPPED'
                      li
                        a.dropdown-item(
                          href=`/scrapAsset/scrap/${asset.id}`
                          onclick="return confirm('Are you sure you want to scrap this asset?')"
                        )
                          i.bi.bi-archive.me-2
                          | Scrap Asset

                    li
                      hr.dropdown-divider

                    li
                      form(
                        action=`/assets/delete/${asset.id}`
                        method='POST'
                        style='margin:0'
                      )
                        button.dropdown-item.text-danger(
                          type='submit'
                          onclick="return confirm('Delete this asset?')"
                        )
                          i.bi.bi-trash.me-2
                          | Delete Asset

block scripts
  script.
    $(document).ready(function () {
      $('#assetTable').DataTable();
    });